.claude/helpers/graft-hooks.cjs

# >>> kleidi-advisor F1.S1 >>>
.venv/
__pycache__/
*.py[cod]
*.egg-info/
results/*
!results/README.md
# Result JSONs are evidence, not scratch: README cites results/audit.json for the
